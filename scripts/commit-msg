#!/usr/bin/env bash
# commit-msg hook — run the redaction guard on the commit message itself.
# Commit messages end up in public history (and in squash-merge PR bodies),
# so they get the same scrutiny as tracked files.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
bash "$REPO_ROOT/scripts/check_redaction.sh" --msg "$1"
